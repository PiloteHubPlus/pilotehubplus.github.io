rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // CORE SECURITY PRIMITIVES & HELPER FUNCTIONS
    // =========================================================================

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isAuthenticated() {
      return request.auth != null;
    }

    // Strict ownership verification: authenticated UID matches targeted document ID
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // ID Poisoning Guard: Document IDs must be alphanumeric strings between 1 and 128 characters
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // =========================================================================
    // SCHEMA VALIDATORS (Anti-Update-Gap & Value Poisoning Guards)
    // =========================================================================

    // Student Profile Validator: Enforces key schema and prevents malicious shadow fields
    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'email', 'displayName', 'grade', 'level'])
        && data.uid is string && data.uid.size() > 0 && data.uid.size() <= 128
        && data.email is string && data.email.size() > 0 && data.email.size() <= 128
        && data.displayName is string && data.displayName.size() > 0 && data.displayName.size() <= 80
        && data.grade is string && data.grade.size() > 0 && data.grade.size() <= 50
        && data.level is string && data.level.size() > 0 && data.level.size() <= 50
        && (!('school' in data) || (data.school is string && data.school.size() <= 100))
        && (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 500))
        && (!('isGuest' in data) || data.isGuest is bool)
        && (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 50));
    }

    // Student Learning Progress & Streak Validator: Enforces type safety and bounded numeric ranges
    function isValidProgress(data) {
      return data.keys().hasAll(['userId', 'currentStreak', 'longestStreak', 'totalMinutesStudied', 'xp'])
        && data.userId is string && data.userId.size() > 0 && data.userId.size() <= 128
        && data.currentStreak is int && data.currentStreak >= 0 && data.currentStreak <= 10000
        && data.longestStreak is int && data.longestStreak >= 0 && data.longestStreak <= 10000
        && data.totalMinutesStudied is int && data.totalMinutesStudied >= 0 && data.totalMinutesStudied <= 1000000
        && data.xp is int && data.xp >= 0 && data.xp <= 10000000
        && (!('completedResourceIds' in data) || (data.completedResourceIds is list && data.completedResourceIds.size() <= 1000))
        && (!('bookmarkedResourceIds' in data) || (data.bookmarkedResourceIds is list && data.bookmarkedResourceIds.size() <= 1000))
        && (!('unlockedBadges' in data) || (data.unlockedBadges is list && data.unlockedBadges.size() <= 100))
        && (!('dailyGoalMinutes' in data) || (data.dailyGoalMinutes is int && data.dailyGoalMinutes >= 5 && data.dailyGoalMinutes <= 720))
        && (!('userName' in data) || (data.userName is string && data.userName.size() <= 80))
        && (!('selectedGrade' in data) || (data.selectedGrade is string && data.selectedGrade.size() <= 50))
        && (!('selectedLevel' in data) || (data.selectedLevel is string && data.selectedLevel.size() <= 50))
        && (!('lastStudyDate' in data) || (data.lastStudyDate is string && data.lastStudyDate.size() <= 50));
    }

    // Community Review Validator: Guards against spam, arbitrary HTML injection, and rating tampering
    function isValidReview(data) {
      return data.keys().hasAll(['author', 'stars', 'comment'])
        && data.author is string && data.author.size() >= 2 && data.author.size() <= 80
        && data.stars is int && data.stars >= 1 && data.stars <= 5
        && data.comment is string && data.comment.size() >= 3 && data.comment.size() <= 2000
        && (!('school' in data) || (data.school is string && data.school.size() <= 100))
        && (!('grade' in data) || (data.grade is string && data.grade.size() <= 50))
        && (!('id' in data) || (data.id is string && data.id.size() <= 128))
        && (!('date' in data) || (data.date is string && data.date.size() <= 50))
        && (!('userId' in data) || (data.userId is string && data.userId == request.auth.uid));
    }

    // =========================================================================
    // 1. GLOBAL SAFETY NET (DEFAULT-DENY CATCH-ALL)
    // =========================================================================
    // Explicitly rejects any request to non-defined collections or root documents
    match /{document=**} {
      allow read, write: if false;
    }

    // =========================================================================
    // 2. USER PROFILES COLLECTION (/users/{userId})
    // =========================================================================
    // ZERO-LEAKAGE GUARANTEE:
    // - allow list: FALSE -> Prohibits anyone from querying or enumerating student accounts
    // - allow get: isOwner -> Only the authenticated student can inspect their own profile
    // - immutability: uid cannot be modified post-creation
    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow list: if false;
      allow create: if isOwner(userId)
                    && isValidId(userId)
                    && isValidUser(incoming())
                    && incoming().uid == userId;
      allow update: if isOwner(userId)
                    && isValidId(userId)
                    && isValidUser(incoming())
                    && incoming().uid == existing().uid;
      allow delete: if isOwner(userId) && isValidId(userId);
    }

    // =========================================================================
    // 3. STUDY PROGRESS & STREAKS COLLECTION (/progress/{userId})
    // =========================================================================
    // COMPLETE DATA ISOLATION:
    // - Private revision notes, study timer logs, and personal streaks are strictly confidential
    // - Listing is forbidden, preventing unauthorized batch scraping
    match /progress/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow list: if false;
      allow create: if isOwner(userId)
                    && isValidId(userId)
                    && isValidProgress(incoming())
                    && incoming().userId == userId;
      allow update: if isOwner(userId)
                    && isValidId(userId)
                    && isValidProgress(incoming())
                    && incoming().userId == existing().userId;
      allow delete: if isOwner(userId) && isValidId(userId);
    }

    // =========================================================================
    // 4. COMMUNITY REVIEWS & FEEDBACK (/reviews/{reviewId})
    // =========================================================================
    // TRANSPARENCY & INTEGRITY:
    // - Publicly readable for all students to discover platform testimonials
    // - Only verified authenticated students can submit a review
    // - IMMUTABLE (update: false, delete: false) to prevent revision history tampering
    match /reviews/{reviewId} {
      allow get, list: if true;
      allow create: if isAuthenticated()
                    && isValidId(reviewId)
                    && isValidReview(incoming());
      allow update, delete: if false;
    }

  }
}
